<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="#1A000000"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Category + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvComplaintCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="#185FA5"
                android:text="🚫 Vi phạm nội quy"/>

            <TextView
                android:id="@+id/tvComplaintStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_unpaid"
                android:textColor="#E74C3C"
                android:text="Chờ xử lý"/>
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvComplaintTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A2744"
            android:text="Hàng xóm vứt rác bừa bãi"/>

        <!-- Description -->
        <TextView
            android:id="@+id/tvComplaintDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#888780"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Căn hộ bên cạnh thường xuyên vứt rác..."/>

        <!-- Image preview -->
        <ImageView
            android:id="@+id/ivComplaintImage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_stat_card"
            android:visibility="gone"/>

        <!-- Admin response -->
        <LinearLayout
            android:id="@+id/layoutAdminResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:background="@drawable/bg_icon_blue"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phản hồi từ Ban quản lý:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#185FA5"/>

            <TextView
                android:id="@+id/tvAdminResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="#1A2744"
                android:text=""/>
        </LinearLayout>

        <!-- Date -->
        <TextView
            android:id="@+id/tvComplaintDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11sp"
            android:textColor="#BBBBBB"
            android:text="2026-06-15 10:30"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>