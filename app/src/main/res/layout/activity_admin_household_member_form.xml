<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_page">
    <LinearLayout android:id="@+id/householdMemberFormHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header_gradient" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="40dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnBackHouseholdMemberForm" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_back" app:tint="@color/white"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvHouseholdMemberFormTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thêm thành viên" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvHouseholdMemberFormSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Thêm thành viên vào căn hộ" android:textColor="#CCFFFFFF" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="144dp" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/shape_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông tin thành viên" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Thành viên sẽ được gán vào căn hộ hiện tại." android:textColor="@color/text_hint" android:textSize="13sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Họ và tên" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtMemberFullName" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: Nguyễn Thị Hoa" android:inputType="textCapWords" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Ngày sinh" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtMemberDateOfBirth" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: 1992-08-15" android:inputType="date" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="CCCD/CMND" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtMemberIdentity" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: 012345678901" android:inputType="number" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Giới tính" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <Spinner android:id="@+id/spnMemberGender" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/shape_card" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Quan hệ với chủ hộ" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <Spinner android:id="@+id/spnMemberRelationship" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/shape_card" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <ProgressBar android:id="@+id/progressHouseholdMemberForm" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:visibility="gone"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="end" android:orientation="horizontal">
                    <Button android:id="@+id/btnCancelHouseholdMemberForm" android:layout_width="wrap_content" android:layout_height="48dp" android:backgroundTint="@android:color/transparent" android:text="Hủy" android:textAllCaps="false" android:textColor="@color/text_hint" android:textStyle="bold"/>
                    <Button android:id="@+id/btnSaveHouseholdMemberForm" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="10dp" android:backgroundTint="@color/navy_primary" android:paddingStart="22dp" android:paddingEnd="22dp" android:text="Thêm thành viên" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>