<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_page">
    <LinearLayout android:id="@+id/adminHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header_gradient" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="48dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnAdminBack" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/shape_hdr_btn" android:contentDescription="Quay về trang chủ admin" android:padding="9dp" android:src="@drawable/ic_back" app:tint="@color/white"/>
            <TextView android:id="@+id/tvAdminListTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Quản lý căn hộ" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/tvAdminListSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tòa nhà, tầng, diện tích và trạng thái" android:textColor="#CCFFFFFF" android:textSize="13sp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="136dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="88dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardApartmentFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#1A000000" app:strokeWidth="0.5dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/layoutApartmentFilterToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bộ lọc căn hộ" android:textColor="@color/navy_primary" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvApartmentFilterSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tất cả tòa • Tất cả tầng • Tất cả trạng thái" android:textColor="@color/text_hint" android:textSize="13sp"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvApartmentFilterArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="▼" android:textColor="@color/navy_primary" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/layoutApartmentFilterPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Tòa" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupBuildingFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" app:singleSelection="true"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tầng" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupFloorFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" app:singleSelection="true"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trạng thái" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupStatusFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" app:singleSelection="true"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <ProgressBar android:id="@+id/progressAdmin" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:visibility="gone"/>
            <LinearLayout android:id="@+id/layoutAdminEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="48dp" android:visibility="gone">
                <TextView android:id="@+id/tvAdminEmptyIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📭" android:textSize="44sp"/>
                <TextView android:id="@+id/tvAdminEmptyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Chưa có dữ liệu" android:textColor="@color/text_hint" android:textSize="14sp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/fabAdminAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" android:text="Làm mới" android:textColor="@color/white" app:backgroundTint="@color/navy_primary" app:icon="@drawable/ic_refresh" app:iconTint="@color/white"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>