<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dịch vụ cư dân"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:text="Khách ra vào, giữ xe và phản ánh"/>
    </LinearLayout>

    <!-- Segmented Control - 3 tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="6dp"
        android:elevation="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabVisitor"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="👥 Khách"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1A2744"
            app:cornerRadius="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabParking"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:text="🏍️ Giữ xe"
            android:textSize="12sp"
            android:textColor="#1A2744"
            app:backgroundTint="#F0F2F5"
            app:cornerRadius="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabComplaint"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="📋 Phản ánh"
            android:textSize="12sp"
            android:textColor="#1A2744"
            app:backgroundTint="#F0F2F5"
            app:cornerRadius="10dp"/>

    </LinearLayout>

    <!-- Container chứa 3 sub-fragment -->
    <FrameLayout
        android:id="@+id/servicesSubContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>