<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_page">
    <LinearLayout android:id="@+id/residentFormHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header_gradient" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="40dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnBackResidentForm" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_back" app:tint="@color/white"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvResidentFormTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thêm chủ hộ" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvResidentFormSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tạo hồ sơ chủ hộ và gán vào căn hộ" android:textColor="#CCFFFFFF" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="144dp" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/shape_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông tin chủ hộ" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Mặc định người được thêm là chủ hộ của căn hộ đã chọn." android:textColor="@color/text_hint" android:textSize="13sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Resident ID" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtResidentId" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: 1" android:inputType="number" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Họ và tên" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtResidentFullName" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: Nguyễn Văn An" android:inputType="textCapWords" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Số điện thoại" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtResidentPhone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: 0901234567" android:inputType="phone" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Email" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtResidentEmail" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: resident@gmail.com" android:inputType="textEmailAddress" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Ngày sinh" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtResidentDateOfBirth" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: 1990-05-20" android:inputType="date" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="CCCD/CMND" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtResidentIdentity" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: 012345678901" android:inputType="number" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Số thành viên" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <EditText android:id="@+id/edtResidentMembersCount" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="Ví dụ: 4" android:inputType="number" android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Giới tính" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <Spinner android:id="@+id/spnResidentGender" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/shape_card" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <TextView style="@style/TextAppearance.AppCompat.Body2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Căn hộ" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <Spinner android:id="@+id/spnResidentApartment" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/shape_card" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <ProgressBar android:id="@+id/progressResidentForm" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:visibility="gone"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="end" android:orientation="horizontal">
                    <Button android:id="@+id/btnCancelResidentForm" android:layout_width="wrap_content" android:layout_height="48dp" android:backgroundTint="@android:color/transparent" android:text="Hủy" android:textAllCaps="false" android:textColor="@color/text_hint" android:textStyle="bold"/>
                    <Button android:id="@+id/btnSaveResidentForm" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="10dp" android:backgroundTint="@color/navy_primary" android:paddingStart="22dp" android:paddingEnd="22dp" android:text="Thêm chủ hộ" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>