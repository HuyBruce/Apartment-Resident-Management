<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <!-- Collapsing Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:contentScrim="@color/navy_primary"
            app:expandedTitleGravity="bottom|center"
            app:expandedTitleMarginBottom="8dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Gradient Background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_header_gradient"/>

            <!-- Avatar + Name area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="16dp"
                app:layout_collapseMode="parallax">

                <!-- Avatar with Camera button -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:src="@drawable/ic_default_avatar"
                        app:civ_border_width="3dp"
                        app:civ_border_color="#66FFFFFF"/>

                    <!-- Online badge -->
                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_badge_verified"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="Nguyễn Văn An"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp"
                    android:text="Cư dân đang hoạt động"/>

                <!-- Apartment chip -->
                <TextView
                    android:id="@+id/tvApartmentChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_white"
                    android:drawableStart="@drawable/ic_building_small"
                    android:drawablePadding="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="#E0FFFFFF"
                    android:textSize="12sp"
                    android:text="Căn hộ A-1205"/>
            </LinearLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:title="Hồ sơ cư dân"
                app:titleTextColor="#FFFFFF"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:weightSum="3">

                <include layout="@layout/item_stat_card"
                    android:id="@+id/statResidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"/>

                <include layout="@layout/item_stat_card"
                    android:id="@+id/statFee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"/>

                <include layout="@layout/item_stat_card"
                    android:id="@+id/statRequest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- Personal Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1A000000"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="#FFFFFF">

                <!-- Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="4dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_icon_blue">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:tint="#185FA5"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="THÔNG TIN CÁ NHÂN"
                            android:textSize="11sp"
                            android:textColor="#888780"
                            android:letterSpacing="0.08"/>
                    </LinearLayout>

                    <!-- Full Name -->
                    <include layout="@layout/item_profile_field"
                        android:id="@+id/fieldName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- Phone -->
                    <include layout="@layout/item_profile_field"
                        android:id="@+id/fieldPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- Email -->
                    <include layout="@layout/item_profile_field"
                        android:id="@+id/fieldEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- DOB -->
                    <include layout="@layout/item_profile_field"
                        android:id="@+id/fieldDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- Gender -->
                    <include layout="@layout/item_profile_field"
                        android:id="@+id/fieldGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Apartment Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardApartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1A000000"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="4dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_icon_teal">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_building"
                                app:tint="#0F6E56"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="THÔNG TIN CĂN HỘ"
                            android:textSize="11sp"
                            android:textColor="#888780"
                            android:letterSpacing="0.08"/>
                    </LinearLayout>

                    <include layout="@layout/item_profile_field"
                        android:id="@+id/fieldApartment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <include layout="@layout/item_profile_field"
                        android:id="@+id/fieldMembers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="1"
                android:layout_marginBottom="24dp">

                <!-- Reset button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoad"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    app:cornerRadius="14dp"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="0.5dp"
                    app:backgroundTint="#FFFFFF"
                    android:textColor="#1A2744"
                    app:iconGravity="textStart"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="#1A2744"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- Save button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#1A2744"
                    android:text="Lưu thay đổi"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_save"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>