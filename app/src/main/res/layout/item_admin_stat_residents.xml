<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/shape_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/shape_stat_icon_blue"
            android:padding="10dp"
            android:src="@drawable/ic_users"
            app:tint="@color/primary_blue" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvTotalResidents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng cư dân"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/shape_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/shape_stat_icon_green"
            android:padding="10dp"
            android:src="@drawable/ic_building"
            app:tint="@color/green_dark" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvTotalApartments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Căn hộ"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/shape_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/shape_stat_icon_orange"
            android:padding="10dp"
            android:src="@drawable/ic_coin"
            app:tint="@color/orange_dark" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvMonthlyRevenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="0đ"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doanh thu"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="5dp"
        android:background="@drawable/shape_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/shape_stat_icon_purple"
            android:padding="10dp"
            android:src="@drawable/ic_tools"
            app:tint="@color/purple_dark" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvPendingRequests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/orange_dark"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yêu cầu chờ"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
